#!/bin/sh
# Commit gate, 2026-09-21: `npm run verify` — tsc, the suite, then the
# headless tools under their verdict — must pass on its OWN exit code before
# anything is committed. The rule was prose until now (a hidden red on
# 2026-09-12 when a grep in a chain stood in for the exit code); this is it
# as a mechanism. One-time setup after clone: git config core.hooksPath hooks
# The tree as it will be committed, 2026-11-16: what is not staged, tracked
# or not, is set aside while verify runs and put back after, whatever verify
# says; a commit leaving out half its change passed, verify having read the
# other half from disk.
cd "$(dirname "$0")/.." || exit 1
aside=0
if ! git diff --quiet || [ -n "$(git ls-files --others --exclude-standard)" ]; then
  git stash push --quiet --keep-index --include-untracked -m "pre-commit: not staged" || { echo "pre-commit: could not set aside what is not staged"; exit 1; }
  aside=1
fi
npm run verify; status=$?
# The logs verify writes, 2026-11-24: verify appends its play to
# docs/helium-runs/<day>.jsonl, and its wake can append to the progress log,
# while what was not staged is set aside; the stash would not pop over them,
# the commit was refused and the set-aside lines stranded in the stash
# (three plays, twice in one evening). Both logs are append-only: verify's
# lines are taken off, the stash put back, and they are appended after it.
if [ "$aside" = 1 ]; then
  kept=$(mktemp -d) || exit 1
  for f in $(git diff --name-only -- docs/helium-runs docs/progress) $(git ls-files --others --exclude-standard -- docs/helium-runs docs/progress); do
    mkdir -p "$kept/$(dirname "$f")"
    if git ls-files --error-unmatch "$f" >/dev/null 2>&1; then
      git diff --no-color -U0 -- "$f" | sed -n 's/^+{/{/p' > "$kept/$f"
      git checkout -q -- "$f"
    else
      mv "$f" "$kept/$f"
    fi
  done
  if ! git stash pop --quiet; then
    echo "pre-commit: what was not staged is kept in the stash \"pre-commit: not staged\"; git stash pop to bring it back; verify's log lines are in $kept"
    exit 1
  fi
  (cd "$kept" && find . -type f) | while read -r f; do mkdir -p "$(dirname "$f")"; cat "$kept/$f" >> "$f"; done
  rm -rf "$kept"
fi
[ "$status" = 0 ] || { echo "pre-commit: npm run verify FAILED — fix it before committing."; exit 1; }
