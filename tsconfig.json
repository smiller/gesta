{
  "compilerOptions": {
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": [
      "es2022",
      "dom",
      "dom.iterable"
    ],
    "types": [
      "node"
    ],
    "strict": true,
    "noEmit": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true
  },
  "include": [
    "src",
    "tools",
    "one-offs",
    "vite.config.ts"
  ],
  "exclude": [
    "tools/out",
    "one-offs/out",
    "tools/helium-*.ts",
    "tools/adapters",
    "tools/heliumPage.ts",
    "tools/heliumDom.d.ts",
    "tools/steps"
  ]
}
